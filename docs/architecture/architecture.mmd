flowchart TD
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    Client(["HTTP client<br/>JSON request"]):::edge
    Cli(["CLI<br/>ask, check, evaluate, schema, serve"]):::edge
    Claude(["Anthropic Messages API<br/>injectable, needs API key"]):::edge

    subgraph Io["Interfaces (stdlib HTTP)"]
        direction TB
        Router["Request router<br/>/ask, /check, /evaluate, /health"]:::core
        Validate["Request validation<br/>question up to 2000 chars, SQL up to 5000"]:::control
    end

    subgraph Pipe["Core logic (analyst pipeline)"]
        direction TB
        Prompt["Prompt builder<br/>schema + question"]:::core
        Fake["FakeProvider<br/>offline keyword translator"]:::core
        Guard{"Guardrails<br/>single SELECT, no banned keywords,<br/>known tables and columns, LIMIT cap"}:::control
        Exec["Execute SQL<br/>sqlite3"]:::core
    end

    subgraph State["Data and state"]
        direction TB
        Schema[("Schema text<br/>employees, departments, sales")]:::data
        Db[("In-memory SQLite<br/>seeded, built per query")]:::data
        Bench[("Benchmark<br/>questions with reference SQL,<br/>unsafe SQL cases")]:::data
    end

    subgraph Obs["Evaluation and outputs"]
        direction TB
        Result["AnalystResult<br/>ok, blocked, or no_sql"]:::obs
        Score["Answer accuracy<br/>guardrail block rate"]:::obs
        Metrics["/metrics<br/>Prometheus counts, latency"]:::obs
    end

    Client -->|POST JSON| Router
    Cli -->|serve| Router
    Cli -->|question| Prompt
    Router --> Validate
    Validate -->|question| Prompt
    Validate -->|SQL for /check| Guard
    Schema -.-> Prompt
    Prompt -->|default| Fake
    Prompt -.->|optional| Claude
    Fake -->|candidate SQL| Guard
    Claude -.->|candidate SQL| Guard
    Guard -->|safe, limited SQL| Exec
    Guard -->|unsafe, reasons| Result
    Db -.-> Exec
    Exec -->|columns and rows| Result
    Bench -->|cases| Score
    Result -.-> Score
    Router -.->|timings| Metrics
