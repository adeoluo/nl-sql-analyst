flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        Cli(["CLI<br/>ask, check, evaluate"]):::edge
        Client(["HTTP client<br/>JSON question"]):::edge
        Router["HTTP router<br/>/ask, /check, /evaluate"]:::core
        Validate["Validation<br/>question, SQL length"]:::control
        Cli ~~~ Client --> Router --> Validate
    end

    subgraph Core["Analyst pipeline"]
        direction TB
        Analyst["Analyst.ask<br/>schema + question"]:::core
        Fake["FakeProvider<br/>offline translator"]:::core
        Guard["Guardrails<br/>read-only SELECT, LIMIT"]:::control
        Exec["Execute SQL<br/>sqlite3"]:::core
        Claude(["Anthropic API<br/>optional, injected"]):::edge
        Analyst --> Fake --> Guard --> Exec ~~~ Claude
    end

    subgraph State["Data and state"]
        direction TB
        Schema[("Schema<br/>employees, sales")]:::data
        Db[("In-memory SQLite<br/>seeded per query")]:::data
        Bench[("Benchmark<br/>reference, unsafe SQL")]:::data
        Schema ~~~ Db ~~~ Bench
    end

    subgraph Obs["Evaluation and outputs"]
        direction TB
        Result["AnalystResult<br/>ok, blocked, no_sql"]:::obs
        Score["Answer accuracy<br/>guardrail block rate"]:::obs
        Metrics["/metrics<br/>Prometheus text"]:::obs
        Result --> Score ~~~ Metrics
    end

    Interfaces -->|question, SQL| Core
    Core -.->|reads| State
    State -.->|cases| Obs
    Core -->|results| Obs
